/*
 * Mono — MonoLauncher's built-in theme.
 * Colors (see MonoTheme.cpp for the palette):
 *   base-950 #120f0c  base-900 #17130f  base-850 #1a1612  base-800 #1e1915  base-700 #26201b
 *   line #2a231d  line-strong #332a23  text #ede6de  text-2 #c9bcae  text-3 #a39586
 *   banana #e8b64a  banana-hover #f0c96e  ink-on-banana #1c1408  leaf #7fbf6a  coral #e0786a
 */

QWidget {
    color: #ede6de;
    selection-background-color: #4a3a1c;
    selection-color: #ede6de;
}

QMainWindow, QDialog {
    background: #17130f;
}

QToolTip {
    background: #26201b;
    color: #ede6de;
    border: 1px solid #332a23;
    border-radius: 4px;
    padding: 4px 6px;
}

/* ---------- Buttons ---------- */

QPushButton {
    background: #1e1915;
    color: #ede6de;
    border: 1px solid #332a23;
    border-radius: 4px;
    padding: 5px 12px;
    min-height: 18px;
}
QPushButton:hover { background: #26201b; border-color: #3f342a; }
QPushButton:pressed { background: #2c251f; }
QPushButton:checked { background: #26201b; border-color: #e8b64a; }
QPushButton:disabled { color: #6f6358; background: #1a1612; border-color: #2a231d; }
QPushButton:focus { border-color: #e8b64a; }

QPushButton:default {
    background: #e8b64a;
    color: #1c1408;
    border: 1px solid #e8b64a;
    font-weight: 600;
}
QPushButton:default:hover { background: #f0c96e; border-color: #f0c96e; }
QPushButton:default:disabled { background: #4a3d24; color: #8a7d70; border-color: #4a3d24; }

QToolButton {
    background: transparent;
    color: #c9bcae;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px 6px;
}
QToolButton:hover { background: #26201b; color: #ede6de; }
QToolButton:pressed, QToolButton:checked { background: #2c251f; color: #ede6de; }
QToolButton:disabled { color: #6f6358; }
QToolButton::menu-indicator { image: none; }
QToolButton[popupMode="1"] { padding-right: 16px; }
QToolButton::menu-button { border: none; width: 14px; }
QToolButton::menu-arrow { image: url(:/icons/mono/scalable/ui-arrow-down.svg); width: 10px; height: 10px; }

/* ---------- Toolbars, menus, status bar ---------- */

QToolBar {
    background: #120f0c;
    border: none;
    spacing: 2px;
    padding: 4px 6px;
}
QToolBar::separator { background: #2a231d; width: 1px; height: 1px; margin: 4px 6px; }
QToolBar#mainToolBar { border-bottom: 1px solid #2a231d; }
QToolBar#instanceToolBar { background: #1a1612; border-left: 1px solid #2a231d; padding: 10px 8px; }
QToolBar#instanceToolBar QToolButton { padding: 5px 8px; text-align: left; }
QToolBar#newsToolBar { border-top: 1px solid #2a231d; }

QMenuBar { background: #120f0c; border-bottom: 1px solid #2a231d; }
QMenuBar::item { background: transparent; padding: 4px 10px; border-radius: 4px; }
QMenuBar::item:selected { background: #26201b; }

QMenu {
    background: #1e1915;
    border: 1px solid #332a23;
    border-radius: 6px;
    padding: 4px;
}
QMenu::item { padding: 5px 24px 5px 10px; border-radius: 4px; }
QMenu::item:selected { background: #2c251f; }
QMenu::item:disabled { color: #6f6358; }
QMenu::separator { height: 1px; background: #2a231d; margin: 4px 6px; }
QMenu::icon { padding-left: 6px; }

QStatusBar { background: #120f0c; border-top: 1px solid #2a231d; color: #a39586; }
QStatusBar::item { border: none; }

/* ---------- Inputs ---------- */

QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QComboBox, QKeySequenceEdit {
    background: #1e1915;
    color: #ede6de;
    border: 1px solid #332a23;
    border-radius: 4px;
    padding: 4px 8px;
    min-height: 18px;
}
QPlainTextEdit, QTextEdit { padding: 4px; }
QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QComboBox:hover { border-color: #3f342a; }
QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus { border-color: #e8b64a; }
QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled { color: #6f6358; background: #1a1612; border-color: #2a231d; }

QComboBox { padding-right: 24px; }
QComboBox::drop-down { border: none; width: 22px; subcontrol-origin: padding; subcontrol-position: center right; }
QComboBox::down-arrow { image: url(:/icons/mono/scalable/ui-arrow-down.svg); width: 12px; height: 12px; }
QComboBox QAbstractItemView {
    background: #1e1915;
    border: 1px solid #332a23;
    border-radius: 4px;
    padding: 4px;
    outline: none;
    selection-background-color: #2c251f;
}

QSpinBox, QDoubleSpinBox { padding-right: 20px; }
QSpinBox::up-button, QDoubleSpinBox::up-button, QSpinBox::down-button, QDoubleSpinBox::down-button {
    border: none; width: 18px; subcontrol-origin: border;
}
QSpinBox::up-button, QDoubleSpinBox::up-button { subcontrol-position: top right; }
QSpinBox::down-button, QDoubleSpinBox::down-button { subcontrol-position: bottom right; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image: url(:/icons/mono/scalable/ui-arrow-up.svg); width: 10px; height: 10px; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image: url(:/icons/mono/scalable/ui-arrow-down.svg); width: 10px; height: 10px; }

QCheckBox, QRadioButton { spacing: 8px; background: transparent; }
QCheckBox::indicator, QRadioButton::indicator, QGroupBox::indicator {
    width: 14px; height: 14px;
    background: #1e1915;
    border: 1px solid #4a3d31;
}
QCheckBox::indicator, QGroupBox::indicator { border-radius: 3px; }
QRadioButton::indicator { border-radius: 8px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover, QGroupBox::indicator:hover { border-color: #e8b64a; }
QCheckBox::indicator:checked, QGroupBox::indicator:checked {
    background: #e8b64a; border-color: #e8b64a;
    image: url(:/icons/mono/scalable/ui-check.svg);
}
QRadioButton::indicator:checked { background: #1e1915; border: 4px solid #e8b64a; width: 8px; height: 8px; }
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled { background: #1a1612; border-color: #2a231d; }
QCheckBox::indicator:checked:disabled { background: #4a3d24; border-color: #4a3d24; }

QSlider::groove:horizontal { height: 4px; background: #2a231d; border-radius: 2px; }
QSlider::sub-page:horizontal { background: #e8b64a; border-radius: 2px; }
QSlider::handle:horizontal { width: 14px; height: 14px; margin: -6px 0; border-radius: 7px; background: #ede6de; }

QProgressBar {
    background: #1e1915; border: 1px solid #2a231d; border-radius: 4px;
    text-align: center; color: #c9bcae; min-height: 14px;
}
QProgressBar::chunk { background: #e8b64a; border-radius: 3px; }

/* ---------- Group boxes, frames ---------- */

QGroupBox {
    background: #1a1612;
    border: 1px solid #2a231d;
    border-radius: 6px;
    margin-top: 22px;
    padding: 10px 8px 8px 8px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 2px;
    padding: 0 2px 4px 2px;
    color: #a39586;
    font-weight: 600;
}

QSplitter::handle { background: #2a231d; }
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 1px; }

/* ---------- Tabs ---------- */

QTabWidget::pane { border: none; border-top: 1px solid #2a231d; top: -1px; }
QTabBar { qproperty-drawBase: 0; }
QTabBar::tab {
    background: transparent;
    color: #a39586;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 7px 12px;
    margin-right: 2px;
}
QTabBar::tab:hover { color: #ede6de; }
QTabBar::tab:selected { color: #ede6de; border-bottom: 2px solid #e8b64a; }
QTabBar::tab:disabled { color: #6f6358; }

/* ---------- Lists, trees, tables ---------- */

QAbstractItemView {
    background: #17130f;
    alternate-background-color: #1a1612;
    border: 1px solid #2a231d;
    border-radius: 6px;
    outline: none;
}
QAbstractItemView::item { padding: 3px 4px; border-radius: 3px; }
QAbstractItemView::item:hover { background: #1e1915; }
QAbstractItemView::item:selected { background: #2c251f; color: #ede6de; }

QListView#instanceView, InstanceView { border: none; border-radius: 0; background: #17130f; }

QHeaderView { background: transparent; border: none; }
QHeaderView::section {
    background: #1a1612;
    color: #a39586;
    border: none;
    border-bottom: 1px solid #2a231d;
    border-right: 1px solid #221c17;
    padding: 6px 8px;
    font-weight: 500;
}
QHeaderView::section:last { border-right: none; }
QTableCornerButton::section { background: #1a1612; border: none; }

/* ---------- Scroll bars ---------- */

QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle { background: #3a3027; border-radius: 3px; min-height: 24px; min-width: 24px; }
QScrollBar::handle:hover { background: #4a3d31; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

/* ---------- Library sidebar (main window) ---------- */

QWidget#librarySidebar { background: #120f0c; border-right: 1px solid #2a231d; }
QLabel#librarySidebarHeading {
    color: #8a7d70;
    font-size: 11px;
    font-weight: 600;
    padding: 2px 8px 4px 8px;
}
QListWidget#librarySidebarList { background: transparent; border: none; }
QListWidget#librarySidebarList::item { padding: 0 8px; border-radius: 4px; color: #a39586; }
QListWidget#librarySidebarList::item:hover { background: #1e1915; color: #ede6de; }
QListWidget#librarySidebarList::item:selected { background: #26201b; color: #ede6de; }
